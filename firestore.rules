rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ▼▼▼ The chat admin (can create/revoke QR keys and remove members) ▼▼▼
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'awarlock2002a@gmail.com';
    }
    // ▲▲▲ Also update ADMIN_EMAIL in index.html if you change this ▲▲▲

    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function isMember() {
      return signedIn() && exists(memberPath(request.auth.uid));
    }

    function memberPath(uid) {
      return /databases/$(database)/documents/members/$(uid);
    }
    function invitePath(key) {
      return /databases/$(database)/documents/invites/$(key);
    }

    // Invite keys (what the QR codes contain). The document ID is the key.
    // Only the admin can see, create, or revoke them. Each key works once.
    match /invites/{key} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['label', 'createdAt'])
        && request.resource.data.label is string
        && request.resource.data.label.size() <= 60
        && request.resource.data.createdAt == request.time;
      allow delete: if isAdmin();

      // Redeeming: the person joining marks the key used by them, in the same
      // batch that creates their membership (see members create below)
      allow update: if signedIn()
        && !('usedBy' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt'])
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.usedAt == request.time
        && !exists(memberPath(request.auth.uid))
        && getAfter(memberPath(request.auth.uid)).data.code == key;
    }

    match /members/{uid} {
      // You can check your own membership; the admin can see everyone
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      // Join with an unused invite key, marking it used in the same batch
      // (the admin can always join)
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code', 'name', 'email', 'joinedAt'])
        && request.resource.data.code is string
        && request.resource.data.code.size() > 0
        && request.resource.data.code.size() <= 100
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        // Name is locked to the Google account's name (or email if it has none)
        && request.resource.data.name == request.auth.token.get('name', request.auth.token.email)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.joinedAt == request.time
        && (isAdmin() || (
              exists(invitePath(request.resource.data.code))
              && !('usedBy' in get(invitePath(request.resource.data.code)).data)
              && getAfter(invitePath(request.resource.data.code)).data.get('usedBy', '') == request.auth.uid));

      // Only the admin can remove people (their used key can't get them back in)
      allow delete: if isAdmin();
      allow update: if false;
    }

    match /messages/{messageId} {
      allow read: if isMember();

      // Can only post as yourself, text only, up to 2000 characters
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['text', 'uid', 'name', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        // Must post under the name locked in when you joined
        && request.resource.data.name == get(memberPath(request.auth.uid)).data.name
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    // Everything else is locked
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
