rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ▼▼▼ The chat admin (can create/revoke QR keys and remove members) ▼▼▼
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'awarlock2002a@gmail.com';
    }
    // ▲▲▲ Also update ADMIN_EMAIL in index.html if you change this ▲▲▲

    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function isMember() {
      return signedIn() && exists(memberPath(request.auth.uid));
    }

    function memberPath(uid) {
      return /databases/$(database)/documents/members/$(uid);
    }
    function invitePath(key) {
      return /databases/$(database)/documents/invites/$(key);
    }

    // Invite keys (what the QR codes contain). The document ID is the key.
    // Only the admin can see, create, or revoke them. Each key works once.
    match /invites/{key} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['label', 'createdAt'])
        && request.resource.data.label is string
        && request.resource.data.label.size() <= 60
        && request.resource.data.createdAt == request.time;
      allow delete: if isAdmin();

      // Redeeming: the person joining marks the key used by them, in the same
      // batch that creates their membership (see members create below)
      allow update: if signedIn()
        && !('usedBy' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt'])
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.usedAt == request.time
        && !exists(memberPath(request.auth.uid))
        && getAfter(memberPath(request.auth.uid)).data.code == key;
    }

    match /members/{uid} {
      // You can check your own membership; the admin can see everyone
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      // Join with an unused invite key, marking it used in the same batch
      // (the admin can always join)
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code', 'name', 'email', 'joinedAt'])
        && request.resource.data.code is string
        && request.resource.data.code.size() > 0
        && request.resource.data.code.size() <= 100
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        // Name is locked to the Google account's name (or email if it has none)
        && request.resource.data.name == request.auth.token.get('name', request.auth.token.email)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.joinedAt == request.time
        && (isAdmin() || (
              exists(invitePath(request.resource.data.code))
              && !('usedBy' in get(invitePath(request.resource.data.code)).data)
              && getAfter(invitePath(request.resource.data.code)).data.get('usedBy', '') == request.auth.uid));

      // Only the admin can remove people (their used key can't get them back in)
      allow delete: if isAdmin();
      allow update: if false;
    }

    match /messages/{messageId} {
      allow read: if isMember();

      // Post as yourself, under the name locked in when you joined
      allow create: if isMember()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name == get(memberPath(request.auth.uid)).data.name
        && request.resource.data.createdAt == request.time
        && (isTextMessage(request.resource.data)
            || isImageMessage(request.resource.data)
            || isGifMessage(request.resource.data));

      allow update, delete: if false;
    }

    // Text, up to 2000 characters
    function isTextMessage(d) {
      return d.keys().hasOnly(['text', 'uid', 'name', 'createdAt'])
        && d.text is string
        && d.text.size() > 0
        && d.text.size() <= 2000;
    }

    // A photo or GIF file you uploaded (stored in /images, sent in the same batch)
    function isImageMessage(d) {
      return d.keys().hasOnly(['type', 'imageId', 'w', 'h', 'uid', 'name', 'createdAt'])
        && d.type == 'image'
        && d.imageId is string
        && d.imageId.size() <= 40
        && hasSize(d)
        && getAfter(/databases/$(database)/documents/images/$(d.imageId)).data.uid == request.auth.uid;
    }

    // A GIF from GIPHY search: only GIPHY's own image addresses are allowed
    function isGifMessage(d) {
      return d.keys().hasOnly(['type', 'gifUrl', 'w', 'h', 'uid', 'name', 'createdAt'])
        && d.type == 'gif'
        && d.gifUrl is string
        && d.gifUrl.size() <= 500
        && d.gifUrl.matches('https://(media[0-9]?|i)[.]giphy[.]com/media/[A-Za-z0-9._/-]+')
        && hasSize(d);
    }

    function hasSize(d) {
      return d.w is int && d.h is int
        && d.w > 0 && d.h > 0 && d.w <= 10000 && d.h <= 10000;
    }

    // Uploaded photos/GIFs, shrunk by the app to fit in one document (~1 MB)
    match /images/{imageId} {
      allow get: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['data', 'uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 1000000
        && request.resource.data.data.matches('data:image/(jpeg|png|webp|gif);base64,[A-Za-z0-9+/=]+');
      allow update, delete: if false;
    }

    // Everything else is locked
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
