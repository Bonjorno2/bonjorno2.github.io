rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Invite codes: create a document in the "invites" collection whose
    // Document ID is the code (lowercase). Nobody can read or list these,
    // so the code can't be discovered from the page.

    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function isMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    match /members/{uid} {
      // You can check your own membership, nobody else's
      allow get: if signedIn() && request.auth.uid == uid;

      // Join by presenting a valid invite code
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code', 'name', 'email', 'joinedAt'])
        && request.resource.data.code is string
        && request.resource.data.code.size() > 0
        && request.resource.data.code.size() <= 100
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.joinedAt == request.time
        && exists(/databases/$(database)/documents/invites/$(request.resource.data.code));

      // Remove someone by deleting their member document in the console
      allow update, delete: if false;
    }

    match /messages/{messageId} {
      allow read: if isMember();

      // Can only post as yourself, text only, up to 2000 characters
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['text', 'uid', 'name', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    // Everything else (including invites) is locked
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
