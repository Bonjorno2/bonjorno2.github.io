rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ▼▼▼ The chat admin (can create/revoke QR keys and remove members) ▼▼▼
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'awarlock2002a@gmail.com';
    }
    // ▲▲▲ Also update ADMIN_EMAIL in index.html if you change this ▲▲▲

    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function isMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    // Invite keys (what the QR codes contain). The document ID is the key.
    // Only the admin can see, create, or revoke them.
    match /invites/{key} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['label', 'createdAt'])
        && request.resource.data.label is string
        && request.resource.data.label.size() <= 60
        && request.resource.data.createdAt == request.time;
      allow delete: if isAdmin();
      allow update: if false;
    }

    match /members/{uid} {
      // You can check your own membership; the admin can see everyone
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      // Join by presenting a valid invite key (the admin can always join)
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code', 'name', 'email', 'joinedAt'])
        && request.resource.data.code is string
        && request.resource.data.code.size() > 0
        && request.resource.data.code.size() <= 100
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.joinedAt == request.time
        && (isAdmin()
            || exists(/databases/$(database)/documents/invites/$(request.resource.data.code)));

      // Only the admin can remove people
      allow delete: if isAdmin();
      allow update: if false;
    }

    match /messages/{messageId} {
      allow read: if isMember();

      // Can only post as yourself, text only, up to 2000 characters
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['text', 'uid', 'name', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    // Everything else is locked
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
